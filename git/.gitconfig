[core]
    editor = vim
[alias]
    br = branch
    cb = checkout -b
    co = checkout
    ci = commit
    ca = commit --amend
    d = diff
    dc = diff --cached
    gl = log --graph --oneline --decorate --all
    pu = push -u origin HEAD
    st = status -sb
    discard = checkout --
    unstage = restore --staged
    undo = reset --soft HEAD^
    last = log -1 HEAD
[include]
    path = ~/.gitconfig.local
